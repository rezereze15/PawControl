APP_NAME=PawControl
APP_ENV=local
# Generate with: php artisan key:generate  (also encrypts/signs sessions & cookies)
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Database: Supabase Postgres (Project Settings > Database > Connection string)
DB_CONNECTION=pgsql
DB_HOST=
DB_PORT=5432
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=file
# CACHE_PREFIX=

# Only used if CACHE_STORE / SESSION_DRIVER / QUEUE_CONNECTION is switched to memcached or redis.
MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Email (e.g. Gmail SMTP with an App Password). Set MAIL_MAILER=log to write emails to the log instead.
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="Paw Control"

# Only needed if FILESYSTEM_DISK=s3.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Supabase Storage (server-side only; never expose the secret key to the browser)
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# Optional bucket names (these are the defaults)
# SUPABASE_PAYMENT_PROOFS_BUCKET=payment-proofs
# SUPABASE_PROFILE_PHOTOS_BUCKET=profile-photos
# SUPABASE_PET_PHOTOS_BUCKET=pet-profiles
# Optional: full path to a CA certificate file (cacert.pem) if PHP can't verify
# Supabase's HTTPS certificate on this machine (common on Windows).
SUPABASE_CA_BUNDLE=

# Sign in with Google (Google Cloud Console > APIs & Services > Credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional; defaults to ${APP_URL}/auth/google/callback
GOOGLE_REDIRECT_URI=
